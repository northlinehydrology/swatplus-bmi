@@ -21,6 +21,7 @@
       use reservoir_data_module
       use water_body_module
       use conditional_module
+      use bmi_exchange_module, only : exch_msk_daily   !! swatplus-bmi: routing_fix = "muskingum_daily"
       
       implicit none
       
@@ -88,7 +89,8 @@
       tot_stor_init = ch_stor_init + fp_stor_init
       
       !! set for daily time step
-      if (time%step == 1) then
+      !! (swatplus-bmi routing_fix: Muskingum keeps the stability substeps its coefficients are for)
+      if (time%step == 1 .and. .not. (exch_msk_daily .and. bsn_cc%rte == 1)) then
         sd_ch(jrch)%msk%nsteps = 1
         sd_ch(jrch)%msk%substeps = 1
       end if
@@ -106,6 +108,9 @@
           isubstep = 1
         end if
         
+        !! swatplus-bmi routing_fix: a channel with no inflow routes none, not the last channel's
+        if (exch_msk_daily .and. time%step == 1 .and. bsn_cc%rte == 1) inflo = 0.
+
         !! add inflow to total storage
         if (ht1%flo > 1.e-6) then
           if (sd_ch(jrch)%msk%nsteps > 1) then
@@ -126,6 +131,8 @@
         !! interpolate rating curve using inflow rates
         icha = jrch
         inflo_rate = inflo / 86400.
+        !! swatplus-bmi routing_fix: inflo is a substep's volume
+        if (exch_msk_daily .and. time%step == 1 .and. bsn_cc%rte == 1) inflo_rate = inflo / dts
         call rcurv_interp_flo (icha, inflo_rate)
         ch_rcurv(jrch)%in2 = rcurv
         
